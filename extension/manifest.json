{
  "manifest_version": 3,
  "name": "Job Tracker Capture",
  "version": "1.0.0",
  "description": "One-click logging of job applications to your local Job Tracker. Talks only to localhost.",
  "action": { "default_popup": "popup.html", "default_title": "Log this application" },
  "permissions": ["activeTab", "scripting"],
  "host_permissions": ["http://localhost:8765/*", "http://127.0.0.1:8765/*"],
  "content_security_policy": { "extension_pages": "script-src 'self'; object-src 'none'; connect-src http://localhost:8765 http://127.0.0.1:8765" },
  "icons": { "16": "icons/icon16.png", "48": "icons/icon48.png", "128": "icons/icon128.png" }
}
